# Sync .project/sourceTexts/ folder (source text files)

# Dependencies and local environment
node_modules/
dist/
.env
.env.*
!.env.example

# Don't sync user-specific SQLite databases
.project/*.sqlite

# Don't sync SQLite auxiliary files
.project/*.sqlite-wal
.project/*.sqlite-shm

# Don't sync user-specific files
.project/complete_drafts.txt
.project/localProjectSettings.json
.project/localProjectSwap.json
copilot-messages.log

# Archive formats
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.bz2
*.xz

# Windows executables and installers
*.exe
*.msi
*.bat
*.cmd
*.com
*.scr
*.dll

# macOS executables and disk images
*.dmg
*.pkg

# Disk images and virtual machine files
*.iso
*.img
*.vhd
*.vmdk

# System files
.DS_Store
Thumbs.db
.project/attachments/files/**

# IDE folders
.vscode/
.idea/

# Build outputs (dist/ already covered above)
build/

# Logs and TS incremental build artifacts
*.log
*.tsbuildinfo

# Curl cookie jars — never commit these
cookies.txt
*.cookie-jar
*.cookies

# Local scratch / dev artifacts (formalize via scripts/dev/ when reused)
scripts/

# Replit / Codex Editor residue — re-imports could recreate these
replit.md
metadata.json
files/

# Claude Code — local-only state
.claude/settings.local.json
.claude/agent-memory/

.env
